{
  "entities": {
    "Card": {
      "title": "Card",
      "description": "A Dragon Ball Super Card Game card",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rarity": { "type": "string" },
        "type": { "type": "string" },
        "color": { "type": "string" },
        "expansion": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sourceProduct": { "type": "string" },
        "releaseDate": { "type": "string" }
      },
      "required": ["id", "name", "rarity", "type", "color", "expansion"]
    },
    "Expansion": {
      "title": "Expansion",
      "description": "An expansion set or group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "sub": { "type": "string" },
        "locked": { "type": "boolean" },
        "isSubItem": { "type": "boolean" },
        "category": { "type": "string" }
      },
      "required": ["id", "label"]
    },
    "Inventory": {
      "title": "Inventory",
      "description": "User's card collection quantity",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "cardId": { "type": "string" },
        "quantity": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "cardId", "quantity"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback messages",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "User earned achievement status",
      "type": "object",
      "properties": {
        "achievementId": { "type": "string" },
        "ownerId": { "type": "string" },
        "unlockedAt": { "type": "string", "format": "date-time" },
        "currentProgress": { "type": "number" },
        "currentTier": { "type": "integer" },
        "isSeen": { "type": "boolean" }
      },
      "required": ["achievementId", "ownerId", "unlockedAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "phone": { "type": "string" },
        "shippingNotes": { "type": "string" },
        "friends": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "WantsList": {
      "title": "WantsList",
      "description": "User customized list of target cards",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "cardIds": { "type": "array", "items": { "type": "string" } },
        "acquiredCardIds": { "type": "array", "items": { "type": "string" } },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "cardIds", "acquiredCardIds"]
    },
    "TurtleTournament": {
      "title": "TurtleTournament",
      "description": "Tournament or league event in Turtle School",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "gameFormat": { "type": "string" },
        "structure": { "type": "string" },
        "startDate": { "type": "string" },
        "status": { "type": "string" },
        "adminAdjustments": { "type": "object" }
      },
      "required": ["name", "type", "status"]
    },
    "TurtleRegistration": {
      "title": "TurtleRegistration",
      "description": "Registration of a player in a tournament or league",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "eventId", "status"]
    },
    "TurtleMatch": {
      "title": "TurtleMatch",
      "description": "Pairing and match result in a tournament or league",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "round": { "type": "integer" },
        "player1Id": { "type": "string" },
        "player2Id": { "type": "string" },
        "player1Wins": { "type": "integer" },
        "player2Wins": { "type": "integer" },
        "draws": { "type": "integer" },
        "player1LeaderId": { "type": "string" },
        "player2LeaderId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["eventId", "round", "player1Id", "status"]
    }
  },
  "firestore": {
    "/cards/{cardId}": {
      "schema": "Card",
      "description": "Global card database"
    },
    "/expansions/{expansionId}": {
      "schema": "Expansion",
      "description": "Expansion metadata"
    },
    "/inventory/{inventoryId}": {
      "schema": "Inventory",
      "description": "User's owned cards"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback"
    },
    "/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "User earned achievements"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/admins/{userId}": {
      "schema": { "type": "object", "properties": { "role": { "type": "string" } } },
      "description": "Admin users list"
    },
    "/lists/{listId}": {
      "schema": "WantsList",
      "description": "Custom wants lists"
    },
    "/ts_tournaments/{tournamentId}": {
      "schema": "TurtleTournament",
      "description": "Turtle School tournaments and leagues"
    },
    "/ts_registrations/{registrationId}": {
      "schema": "TurtleRegistration",
      "description": "Turtle School player registrations"
    },
    "/ts_matches/{matchId}": {
      "schema": "TurtleMatch",
      "description": "Turtle School match pairings and results"
    }
  }
}
