rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerifiedUser() {
      return isSignedIn();
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collection Matches ---
    
    match /cards/{cardId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }
    
    match /expansions/{expansionId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow get: if isOwner(resource.data.ownerId) || isAdmin();
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId);
    }
    
    match /achievements/{achievementId} {
      allow get: if isOwner(resource.data.ownerId) || isAdmin();
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /matches/{matchId} {
      allow read, write: if isSignedIn();
    }
    
    // Fix for the career issue!
    match /users/{userId}/career/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read: if isVerifiedUser() || isAdmin();
      allow create: if isVerifiedUser() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    match /feedback/{feedbackId} {
      allow create: if isVerifiedUser();
      allow read: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }

    match /lists/{listId} {
      allow get: if resource.data.isPublic == true || (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if isVerifiedUser();
      allow update: if isOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }
    
    match /test/connection {
      allow read: if isVerifiedUser();
    }

    // Helper for incoming data
    function incoming() {
      return request.resource.data;
    }
  }
}
